{
  "manifest_version": 3,
  "name": "Canon 레퍼런스 가져오기",
  "version": "1.0.0",
  "description": "로그인한 내 브라우저에서 소설 화 본문을 모아 Canon 레퍼런스 원고의 받은 화로 보내요.",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Canon으로 보내기" }
}
